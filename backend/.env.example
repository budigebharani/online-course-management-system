# ==========================================
# Online Course Management System (OCMS)
# Backend Environment Configuration Template
# ==========================================

# Server Port (Default is 5000)
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your real MongoDB Atlas credentials.
# Example: mongodb+srv://myAdmin:P%40ssw0rd@cluster0.abcde.mongodb.net/ocms_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ocms_db?retryWrites=true&w=majority

# JWT Secret Key for token signing and verification
# Use a strong random secret key for production (e.g., minimum 32 characters)
JWT_SECRET=ocms_jwt_secret_key_super_secure_2026_dev_mode

# JWT Token Expiration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
